<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Timer settings -->
    <add key="WeatherPollMinutes" value="15" />
    <add key="MeterFilePollMinutes" value="60" />
    <add key="ErrorRetrySeconds" value="300" />
    <!-- Weather API -->
    <add key="WeatherApiBaseUrl" value="https://api.weather-demo.example/v1/observations" />
    <add key="WeatherApiKey" value="DEMO-KEY-NOT-A-REAL-SECRET" />
    <add key="StationList" value="STN001,STN002,STN003" />
    <!-- Meter file drop -->
    <add key="MeterInboundPath" value="\\fileshare.demo.example\meters\inbound" />
    <add key="MeterArchivePath" value="\\fileshare.demo.example\meters\archive" />
    <!-- Oracle -->
    <add key="OracleConnection" value="Data Source=DEMODB;User Id=demo_svc;Password=DEMO-NOT-A-REAL-PASSWORD" />
  </appSettings>
</configuration>
